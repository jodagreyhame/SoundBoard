# Binaries. The only build output is build/bin/soundboard.exe (see README Build);
# *.exe covers it plus any stray local build.
*.exe

# Go
vendor/

# Build artifacts
/dist/
# Wails compiled binaries (the source frontend/dist below is NOT a build artifact)
build/bin/
# The vanilla frontend lives in frontend/dist and is source — never ignore it.
!frontend/dist/
!frontend/dist/**

# Wails packaging scratch (zipped distributables)
*.zip

# Verification / proof screenshots (transient). All proof shots use the _name.png
# convention (the design's authoritative comps live under design/, not here).
_*.png

# OS
Thumbs.db
desktop.ini

# The clip library is user-supplied and never committed. No audio ships with this
# project, and PRs adding audio are declined (see CONTRIBUTING.md).
#
# The leading slash is load-bearing: a bare `sounds/` matches at ANY depth and
# would silently untrack internal/catalog/testdata/sounds/, which the catalog
# tests need. Root-anchored, it matches only the library.
/sounds/

# Content work scratch
sounds_src/
*.part
*.ytdl
.raw_*
*.exe~

# Wails-generated JS bindings and runtime. Regenerated by every wails build,
# referenced by nothing in the shipped code (the binary embeds frontend/dist),
# and a vendored copy of upstream Wails rather than this project source.
frontend/wailsjs/
